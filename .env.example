# Environment Configuration (Optional)

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Engine Configuration
NEXT_PUBLIC_STOCKFISH_WASM_URL=/wasm/stockfish.wasm
NEXT_PUBLIC_DEFAULT_ELO=1600

# Game Configuration
NEXT_PUBLIC_MAX_GAME_HISTORY=500
NEXT_PUBLIC_ENGINE_TIMEOUT=3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYSIS=false
NEXT_PUBLIC_ENABLE_MULTIPLAYER=false
NEXT_PUBLIC_ENABLE_PUZZLES=false
